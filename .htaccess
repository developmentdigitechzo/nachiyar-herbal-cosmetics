# ==============================================================================
# NACHIYAR HERBALS & COSMETICS - APACHE / CPANEL REWRITE CONFIGURATION
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Strip .html extension and redirect with trailing slash (e.g. /shop.html -> /shop/)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ %1/ [R=301,L]

  # 2. Block /admin and /admin-login completely (404 Not Found)
  RewriteRule ^admin(/.*)?$ - [R=404,L,NC]
  RewriteRule ^admin-login(/.*)?$ - [R=404,L,NC]

  # 3. Route all clean /nimda/* subpaths (e.g. /nimda/dashboard/) to nimda.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^nimda(/.*)?$ nimda.html [L,QSA]

  # 4. Clean URL routing for static HTML files
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)/?$ $1.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
