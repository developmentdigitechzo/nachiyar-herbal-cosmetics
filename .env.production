# ==============================================================================
# NACHIYAR HERBALS & COSMETICS - PRODUCTION CONFIGURATION
# Automatically loaded when running in production / cPanel (nachiyarherbals.com)
# ==============================================================================

NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# Production PostgreSQL Database Credentials (cPanel)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=nachiyarherbals_client_db
DB_PASSWORD=nachiyarherbals_db
DB_NAME=nachiyarherbals_db
DATABASE_URL=postgresql://nachiyarherbals_client_db:nachiyarherbals_db@127.0.0.1:5432/nachiyarherbals_db
DB_SSL=false

# ------------------------------------------------------------------------------
# Production Storage Configuration (cPanel)
# ------------------------------------------------------------------------------
STORAGE_TYPE=cpanel
CPANEL_STORAGE_PATH=/home/username/public_html/uploads
STORAGE_BASE_URL=/uploads

# ------------------------------------------------------------------------------
# Staff Credentials
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=admin123
INVENTORY_PASSWORD=inventory123
BILLING_PASSWORD=billing123
JWT_SECRET=nachiyar_production_jwt_secret_2026

# ------------------------------------------------------------------------------
# Firebase Client Authentication (Google Sign-In)
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps (Web)
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

