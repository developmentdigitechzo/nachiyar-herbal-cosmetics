# ==============================================================================
# NACHIYAR HERBALS & COSMETICS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.development for local work or .env.production for deployment
# ==============================================================================

# Runtime Environment ('development' or 'production')
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Full connection string or individual components:
DATABASE_URL=postgresql://username:password@localhost:5432/nachiyar_herbals
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=nachiyar_herbals
DB_SSL=false

# ------------------------------------------------------------------------------
# File Storage Configuration
# - Local Development: STORAGE_TYPE=local (stores in ./uploads)
# - Production cPanel: STORAGE_TYPE=cpanel (stores in CPANEL_STORAGE_PATH, e.g. /home/user/public_html/uploads)
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
UPLOAD_DIR=uploads
CPANEL_STORAGE_PATH=/home/username/public_html/uploads
STORAGE_BASE_URL=/uploads

# ------------------------------------------------------------------------------
# Staff Credentials & Security
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=admin123
INVENTORY_PASSWORD=inventory123
BILLING_PASSWORD=billing123
JWT_SECRET=your_jwt_secret_key_here

# ------------------------------------------------------------------------------
# Google Identity Services (Google OAuth Web Client ID)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript Origins: http://localhost:5000, https://yourdomain.com
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_optional

# ------------------------------------------------------------------------------
# Transactional Email & OTP Service (SMTP Configuration)
# For cPanel: SMTP_HOST=mail.nachiyarherbals.com, SMTP_PORT=465, SMTP_SECURE=true
# For Gmail:  SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=yourbrand@gmail.com, SMTP_PASS=your_16_char_app_password
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nachiyar Herbals & Cosmetics" <care@nachiyarherbals.com>



