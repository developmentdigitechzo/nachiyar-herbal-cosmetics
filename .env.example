# ==============================================================================
# NACHIYAR HERBALS & COSMETICS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.development for local work or .env.production for deployment
# ==============================================================================

# Runtime Environment ('development' or 'production')
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Full connection string or individual components:
DATABASE_URL=postgresql://username:password@localhost:5432/nachiyar_herbals
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=nachiyar_herbals
DB_SSL=false

# ------------------------------------------------------------------------------
# File Storage Configuration
# - Local Development: STORAGE_TYPE=local (stores in ./uploads)
# - Production cPanel: STORAGE_TYPE=cpanel (stores in CPANEL_STORAGE_PATH, e.g. /home/user/public_html/uploads)
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
UPLOAD_DIR=uploads
CPANEL_STORAGE_PATH=/home/username/public_html/uploads
STORAGE_BASE_URL=/uploads

# ------------------------------------------------------------------------------
# Staff Credentials & Security
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=admin123
INVENTORY_PASSWORD=inventory123
BILLING_PASSWORD=billing123
JWT_SECRET=your_jwt_secret_key_here
