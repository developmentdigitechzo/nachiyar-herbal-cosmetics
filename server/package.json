{
  "name": "nachiyar-herbals-server",
  "version": "1.0.0",
  "description": "Nachiyar Herbals & Cosmetics - Node.js Express & PostgreSQL Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "start:prod": "node -e \"process.env.NODE_ENV='production'; require('./src/index.js')\"",
    "server": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "test:env": "node ../test-environments.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0"
  }
}
